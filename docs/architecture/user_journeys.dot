digraph user_journeys {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.65", splines=ortho, fontname="Segoe UI", label="Main user journeys - verified UI, worker, storage, and error paths", labelloc=t, fontsize=21];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, margin="0.12,0.08", color="#475569"];
  edge [fontname="Segoe UI", fontsize=8, color="#475569", arrowsize=0.7];
  user [label="User", fillcolor="#DBEAFE"];
  launch [label="app.py -> QApplication -> MainWindow\nQt event loop", fillcolor="#BFDBFE"];
  choose [label="Choose a tab and local inputs\npath validation before worker", fillcolor="#DBEAFE"];
  lineage [label="Run lineage\nPipelineWorker", fillcolor="#CCFBF1"];
  lineage_read [label="Read PBIX + dataflow JSON\nresolve M/dataflow/physical source lineage", fillcolor="#CCFBF1"];
  lineage_write [label="Write two XLSX reports\nreturn counts + flagged rows", fillcolor="#FEF3C7"];
  export [label="Export dataflows\nDataflowExportWorker", fillcolor="#CCFBF1"];
  export_auth [label="PowerShell -> Connect-PowerBIServiceAccount\ninteractive/cached sign-in", fillcolor="#EDE9FE"];
  export_write [label="REST list/download -> JSON\npersist GUID/name cache", fillcolor="#FEF3C7"];
  impact [label="Analyze model change\nModelChangeImpactWorker", fillcolor="#CCFBF1"];
  impact_read [label="Read two PBIX snapshots + layouts\ndiff + DAX dependency impact", fillcolor="#CCFBF1"];
  impact_write [label="Write Model_Change_Impact_*.xlsx\nsummary counts + impacted visuals", fillcolor="#FEF3C7"];
  baseline [label="Generate baseline\nBaselineEstimationWorker", fillcolor="#CCFBF1"];
  baseline_read [label="Read one PBIX + optional requirements workbook\nmap objects to visuals", fillcolor="#CCFBF1"];
  baseline_write [label="Write RTM workbook\nrecord SQLite history", fillcolor="#FEF3C7"];
  result [label="UI receives Qt finished_ok\nopen output file/folder", fillcolor="#BFDBFE"];
  error [label="UI receives failed / InfoBar error\ninvalid path, exception, timeout, permission, or auth failure", fillcolor="#FEE2E2"];
  update [label="About -> update check\nGit remote comparison", fillcolor="#EDE9FE"];
  update_apply [label="Explicit update -> git pull + pip install\nrestart detached process", fillcolor="#EDE9FE"];

  user -> launch [label="double-click / python app.py"];
  launch -> choose [label="event loop"];
  choose -> lineage [label="Run Pipeline"];
  choose -> export [label="Download All Dataflows"];
  choose -> impact [label="Analyze Changes"];
  choose -> baseline [label="Generate Baseline Impact"];
  choose -> update [label="About tab"];
  lineage -> lineage_read [label="QThread function call"];
  lineage_read -> lineage_write [label="openpyxl"];
  lineage_write -> result [label="finished_ok signal"];
  export -> export_auth [label="subprocess PowerShell"];
  export_auth -> export_write [label="Power BI cmdlets + REST"];
  export_write -> result [label="##RESULT## parsed"];
  impact -> impact_read [label="QThread function calls"];
  impact_read -> impact_write [label="openpyxl"];
  impact_write -> result [label="finished_ok signal"];
  baseline -> baseline_read [label="QThread function calls"];
  baseline_read -> baseline_write [label="openpyxl + sqlite3"];
  baseline_write -> result [label="finished_ok signal"];
  choose -> error [label="missing/invalid path", style=dashed];
  lineage_read -> error [label="engine/permission/cancel", style=dashed];
  export_auth -> error [label="auth/module/workspace/API", style=dashed];
  impact_read -> error [label="PBIX/layout/permission", style=dashed];
  baseline_read -> error [label="PBIX/requirements/permission", style=dashed];
  update -> update_apply [label="user clicks install"];
  update -> error [label="remote/git failure", style=dashed];
  update_apply -> launch [label="restart", style=dashed];
  legend [label="Legend\nsolid = normal implemented journey\ndashed = implemented error/optional transition", fillcolor="white", style="rounded,dashed,filled"];
}